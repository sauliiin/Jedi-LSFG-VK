{
  "name": "jedi-lsfg-vk",
  "version": "1.2.0",
  "description": "Adaptive Lossless Scaling frame generation with a single target FPS, powered by MAKO Renderer",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "node --experimental-strip-types --test tests/steamLaunchOptions.test.ts tests/nowPlaying.test.ts tests/gameTargets.test.ts && python3 -m unittest discover -s tests -p 'test_*.py'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sauliiin/Jedi-LSFG-VK.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "deck",
    "lossless-scaling",
    "frame-generation",
    "lsfg-vk",
    "framegen",
    "adaptive",
    "mako"
  ],
  "author": "Saulo Hugo Rossi",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/sauliiin/Jedi-LSFG-VK/issues"
  },
  "homepage": "https://github.com/sauliiin/Jedi-LSFG-VK#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.1",
    "@decky/ui": "^4.7.2",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.22.5",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.2",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.22.5",
    "@rollup/rollup-linux-x64-musl": "4.22.5"
  },
  "remote_binary_bundling": true,
  "remote_binary": [
    {
      "name": "MAKO-Renderer-v4.6.0-linux.tar.xz",
      "url": "https://github.com/eugeniosegala/MAKO/releases/download/render-v4.6.0/MAKO-Renderer-v4.6.0-linux.tar.xz",
      "sha256hash": "66224414e2d94f7cb019226735b3b6d26b9be7103c5334250522f7260213be56"
    }
  ],
  "pnpm": {
    "supportedArchitectures": {
      "cpu": [
        "arm64",
        "x64"
      ],
      "libc": [
        "glibc",
        "musl"
      ],
      "os": [
        "darwin",
        "linux"
      ]
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
